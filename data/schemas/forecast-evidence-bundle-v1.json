{
  "$defs": {
    "DataSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "case_id",
        "snapshot_id",
        "manifest_digest",
        "content_digest",
        "as_of",
        "frozen_at"
      ],
      "title": "DataSnapshot",
      "type": "object"
    },
    "EvidenceDigestRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "evidence_digest"
      ],
      "title": "EvidenceDigestRef",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "capture_metadata_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Capture Metadata Digest",
          "type": "string"
        },
        "document_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Document Type",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Time"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "extraction_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Extraction Confidence"
        },
        "extractor_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Extractor Version",
          "type": "string"
        },
        "first_observed_at": {
          "format": "date-time",
          "title": "First Observed At",
          "type": "string"
        },
        "historical_safe": {
          "title": "Historical Safe",
          "type": "boolean"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "parser_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Parser Version",
          "type": "string"
        },
        "prompt_injection_flags": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Prompt Injection Flags",
          "type": "array"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "raw_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Content Digest",
          "type": "string"
        },
        "raw_object_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Raw Object Uri",
          "type": "string"
        },
        "revised_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revised At"
        },
        "revision_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        },
        "rights_manifest_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rights Manifest Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Source Quality"
        },
        "source_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "untrusted_content": {
          "const": true,
          "default": true,
          "title": "Untrusted Content",
          "type": "boolean"
        },
        "vendor_ingested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor Ingested At"
        }
      },
      "required": [
        "tenant_id",
        "evidence_id",
        "source_type",
        "entity_ids",
        "document_type",
        "first_observed_at",
        "available_at",
        "ingested_at",
        "raw_object_uri",
        "raw_content_digest",
        "capture_metadata_digest",
        "extractor_version",
        "parser_version",
        "rights_manifest_id",
        "source_quality",
        "extraction_confidence",
        "historical_safe"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "Forecast": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        },
        "expected_return": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Expected Return"
        },
        "feature_provenance": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Provenance"
        },
        "horizon_days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "probability_positive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Probability Positive"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Uncertainty"
        }
      },
      "required": [
        "instrument_id",
        "horizon_days",
        "expected_return",
        "probability_positive",
        "confidence",
        "uncertainty"
      ],
      "title": "Forecast",
      "type": "object"
    },
    "NumericClaim": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Id"
        },
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_coordinate": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Coordinate",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "tenant_id",
        "claim_id",
        "name",
        "value",
        "unit",
        "evidence_id",
        "source_coordinate"
      ],
      "title": "NumericClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "counter_evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Counter Evidence Ids",
      "type": "array"
    },
    "evaluation_cutoff": {
      "format": "date-time",
      "title": "Evaluation Cutoff",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceDigestRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "forecast": {
      "$ref": "#/$defs/Forecast"
    },
    "forecast_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Forecast Digest",
      "type": "string"
    },
    "numeric_claims": {
      "items": {
        "$ref": "#/$defs/NumericClaim"
      },
      "title": "Numeric Claims",
      "type": "array"
    },
    "resolved_counter_evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Resolved Counter Evidence Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/DataSnapshot"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "snapshot_id",
    "snapshot",
    "evaluation_cutoff",
    "forecast",
    "forecast_digest",
    "evidence",
    "evidence_refs",
    "numeric_claims",
    "supporting_evidence_ids"
  ],
  "title": "ForecastEvidenceBundle",
  "type": "object"
}
