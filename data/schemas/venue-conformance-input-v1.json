{
  "$defs": {
    "OrderBundle": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "broker_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Broker Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/TradingEnvironment"
        },
        "legal_entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/OrderIntent"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Orders",
          "type": "array"
        },
        "portfolio_state_sequence": {
          "minimum": 0,
          "title": "Portfolio State Sequence",
          "type": "integer"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "strategy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Strategy Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "environment",
        "legal_entity_id",
        "account_id",
        "broker_id",
        "strategy_id",
        "case_id",
        "request_id",
        "portfolio_state_sequence",
        "orders"
      ],
      "title": "OrderBundle",
      "type": "object"
    },
    "OrderIntent": {
      "additionalProperties": false,
      "properties": {
        "client_order_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Client Order Id",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Version",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "order_type": {
          "$ref": "#/$defs/OrderType"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "side": {
          "$ref": "#/$defs/OrderSide"
        },
        "time_in_force": {
          "$ref": "#/$defs/TimeInForce"
        },
        "venue_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Venue Id",
          "type": "string"
        }
      },
      "required": [
        "client_order_id",
        "instrument_id",
        "instrument_version",
        "venue_id",
        "side",
        "order_type",
        "time_in_force",
        "quantity",
        "currency"
      ],
      "title": "OrderIntent",
      "type": "object"
    },
    "OrderSide": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "MARKET",
        "LIMIT"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "ProductionReleaseManifest": {
      "additionalProperties": false,
      "description": "Exact evidence set required before a venue-specific LIVE adapter may be activated.",
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "backup_restore_drill_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Backup Restore Drill Digest",
          "type": "string"
        },
        "broker_agreement_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Broker Agreement Digest",
          "type": "string"
        },
        "broker_api_hostnames": {
          "items": {
            "type": "string"
          },
          "title": "Broker Api Hostnames",
          "type": "array"
        },
        "broker_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Broker Id",
          "type": "string"
        },
        "compliance_policy_pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compliance Policy Pack Digest",
          "type": "string"
        },
        "compliance_policy_pack_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Compliance Policy Pack Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_rights_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Data Rights Digest",
          "type": "string"
        },
        "database_migration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Database Migration Digest",
          "type": "string"
        },
        "deployment_artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Deployment Artifact Digest",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "legal_compliance_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Legal Compliance Digest",
          "type": "string"
        },
        "legal_entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "model_validation_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Validation Manifest Digest",
          "type": "string"
        },
        "network_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Network Policy Digest",
          "type": "string"
        },
        "object_store_conformance_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Object Store Conformance Digest",
          "type": "string"
        },
        "profile": {
          "const": "PERSONAL_LOCAL",
          "default": "PERSONAL_LOCAL",
          "title": "Profile",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "requested_capability": {
          "const": "LIVE_EXECUTION",
          "default": "LIVE_EXECUTION",
          "title": "Requested Capability",
          "type": "string"
        },
        "risk_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Risk Policy Digest",
          "type": "string"
        },
        "sbom_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sbom Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "secrets_management_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Secrets Management Digest",
          "type": "string"
        },
        "security_assessment_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Security Assessment Digest",
          "type": "string"
        },
        "service_recovery_drill_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Service Recovery Drill Digest",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "release_id",
        "compliance_policy_pack_id",
        "compliance_policy_pack_digest",
        "legal_entity_id",
        "account_id",
        "broker_id",
        "broker_api_hostnames",
        "deployment_artifact_digest",
        "sbom_digest",
        "database_migration_digest",
        "object_store_conformance_digest",
        "backup_restore_drill_digest",
        "service_recovery_drill_digest",
        "security_assessment_digest",
        "model_validation_manifest_digest",
        "legal_compliance_digest",
        "data_rights_digest",
        "broker_agreement_digest",
        "risk_policy_digest",
        "network_policy_digest",
        "secrets_management_digest",
        "created_at",
        "expires_at"
      ],
      "title": "ProductionReleaseManifest",
      "type": "object"
    },
    "TimeInForce": {
      "enum": [
        "DAY"
      ],
      "title": "TimeInForce",
      "type": "string"
    },
    "TradingEnvironment": {
      "enum": [
        "SIM",
        "PAPER"
      ],
      "title": "TradingEnvironment",
      "type": "string"
    },
    "VenueAdapterProfile": {
      "additionalProperties": false,
      "description": "Safety capabilities a future provider adapter must prove with recorded fixtures.",
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "allowed_hostnames": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hostnames",
          "type": "array"
        },
        "broker_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Broker Id",
          "type": "string"
        },
        "compliance_policy_pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compliance Policy Pack Digest",
          "type": "string"
        },
        "compliance_policy_pack_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Compliance Policy Pack Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "max_submission_timeout_seconds": {
          "maximum": 60,
          "minimum": 1,
          "title": "Max Submission Timeout Seconds",
          "type": "integer"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "supported_order_types": {
          "items": {
            "$ref": "#/$defs/OrderType"
          },
          "title": "Supported Order Types",
          "type": "array"
        },
        "supports_cancellation": {
          "const": true,
          "default": true,
          "title": "Supports Cancellation",
          "type": "boolean"
        },
        "supports_client_order_idempotency": {
          "const": true,
          "default": true,
          "title": "Supports Client Order Idempotency",
          "type": "boolean"
        },
        "supports_order_status_retrieval": {
          "const": true,
          "default": true,
          "title": "Supports Order Status Retrieval",
          "type": "boolean"
        }
      },
      "required": [
        "adapter_id",
        "broker_id",
        "compliance_policy_pack_id",
        "compliance_policy_pack_digest",
        "allowed_hostnames",
        "supported_order_types",
        "max_submission_timeout_seconds",
        "reviewed_at",
        "expires_at"
      ],
      "title": "VenueAdapterProfile",
      "type": "object"
    },
    "VenueOrderAcknowledgement": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "broker_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Broker Id",
          "type": "string"
        },
        "client_order_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Client Order Id",
          "type": "string"
        },
        "command_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Command Digest",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "venue_order_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Venue Order Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "account_id",
        "broker_id",
        "command_digest",
        "client_order_id",
        "venue_order_id",
        "status",
        "observed_at"
      ],
      "title": "VenueOrderAcknowledgement",
      "type": "object"
    },
    "VenueSubmissionCommand": {
      "additionalProperties": false,
      "description": "Exact fixture command for conformance tests; it is never a network request.",
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "broker_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Broker Id",
          "type": "string"
        },
        "client_order_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Client Order Ids",
          "type": "array"
        },
        "compliance_policy_pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compliance Policy Pack Digest",
          "type": "string"
        },
        "compliance_policy_pack_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Compliance Policy Pack Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "legal_entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "order_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Order Bundle Digest",
          "type": "string"
        },
        "release_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Manifest Digest",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "submission_hostname": {
          "title": "Submission Hostname",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "release_manifest_digest",
        "compliance_policy_pack_id",
        "compliance_policy_pack_digest",
        "legal_entity_id",
        "account_id",
        "broker_id",
        "request_id",
        "order_bundle_digest",
        "client_order_ids",
        "submission_hostname",
        "not_before",
        "expires_at"
      ],
      "title": "VenueSubmissionCommand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acknowledgements": {
      "items": {
        "$ref": "#/$defs/VenueOrderAcknowledgement"
      },
      "title": "Acknowledgements",
      "type": "array"
    },
    "command": {
      "$ref": "#/$defs/VenueSubmissionCommand"
    },
    "now": {
      "format": "date-time",
      "title": "Now",
      "type": "string"
    },
    "order_bundle": {
      "$ref": "#/$defs/OrderBundle"
    },
    "profile": {
      "$ref": "#/$defs/VenueAdapterProfile"
    },
    "release": {
      "$ref": "#/$defs/ProductionReleaseManifest"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "release",
    "profile",
    "order_bundle",
    "command",
    "acknowledgements",
    "now"
  ],
  "title": "VenueConformanceInput",
  "type": "object"
}
