{
  "$defs": {
    "CasePurpose": {
      "enum": [
        "research",
        "rebalance",
        "event_response",
        "strategy_validation",
        "paper_trade"
      ],
      "title": "CasePurpose",
      "type": "string"
    },
    "CaseStatus": {
      "enum": [
        "CASE_CREATED",
        "MANDATE_VALIDATED",
        "DATA_SNAPSHOT_FROZEN",
        "RESEARCH_DEPTH_SELECTED",
        "RESEARCH_PLANNED",
        "SPECIALISTS_DISPATCHED",
        "EVIDENCE_AUDITED",
        "FORECAST_PROPOSED",
        "FORECAST_VERIFIED",
        "STRATEGY_VALIDATED",
        "PORTFOLIO_OPTIMIZED",
        "RISK_APPROVED",
        "HUMAN_APPROVED",
        "AUTO_APPROVED",
        "EXECUTION_RELEASED",
        "RECONCILED",
        "OUTCOME_MATURED",
        "LEARNING_REVIEWED"
      ],
      "title": "CaseStatus",
      "type": "string"
    },
    "InvestmentCaseRequest": {
      "additionalProperties": false,
      "properties": {
        "analysis_time": {
          "format": "date-time",
          "title": "Analysis Time",
          "type": "string"
        },
        "data_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Snapshot Id"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "forecast_horizon_days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Forecast Horizon Days",
          "type": "integer"
        },
        "instrument_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "maximum_cost_usd": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Maximum Cost Usd",
          "type": "string"
        },
        "portfolio_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portfolio Snapshot Id"
        },
        "purpose": {
          "$ref": "#/$defs/CasePurpose"
        },
        "requested_mode": {
          "$ref": "#/$defs/ResearchMode"
        },
        "strategy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
        "strategy_id",
        "instrument_ids",
        "analysis_time",
        "forecast_horizon_days",
        "requested_mode",
        "maximum_cost_usd",
        "purpose"
      ],
      "title": "InvestmentCaseRequest",
      "type": "object"
    },
    "ResearchMode": {
      "enum": [
        "screen",
        "standard",
        "deep",
        "exceptional"
      ],
      "title": "ResearchMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Created By",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/InvestmentCaseRequest"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/CaseStatus"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "request",
    "status",
    "created_at",
    "created_by"
  ],
  "title": "InvestmentCase",
  "type": "object"
}
