{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "retention_class": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Retention Class",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "uri",
        "content_digest",
        "size_bytes",
        "media_type",
        "retention_class"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "ProductionReleaseManifest": {
      "additionalProperties": false,
      "description": "Exact evidence set required before a venue-specific LIVE adapter may be activated.",
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "backup_restore_drill_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Backup Restore Drill Digest",
          "type": "string"
        },
        "broker_agreement_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Broker Agreement Digest",
          "type": "string"
        },
        "broker_api_hostnames": {
          "items": {
            "type": "string"
          },
          "title": "Broker Api Hostnames",
          "type": "array"
        },
        "broker_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Broker Id",
          "type": "string"
        },
        "compliance_policy_pack_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compliance Policy Pack Digest",
          "type": "string"
        },
        "compliance_policy_pack_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Compliance Policy Pack Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_rights_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Data Rights Digest",
          "type": "string"
        },
        "database_migration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Database Migration Digest",
          "type": "string"
        },
        "deployment_artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Deployment Artifact Digest",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/ReleaseEvidenceReference"
          },
          "title": "Evidence References",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "legal_compliance_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Legal Compliance Digest",
          "type": "string"
        },
        "legal_entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "max_recovery_drill_age_seconds": {
          "maximum": 7776000,
          "minimum": 1,
          "title": "Max Recovery Drill Age Seconds",
          "type": "integer"
        },
        "model_validation_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Validation Manifest Digest",
          "type": "string"
        },
        "network_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Network Policy Digest",
          "type": "string"
        },
        "object_store_conformance_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Object Store Conformance Digest",
          "type": "string"
        },
        "profile": {
          "const": "PERSONAL_LOCAL",
          "default": "PERSONAL_LOCAL",
          "title": "Profile",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "requested_capability": {
          "const": "LIVE_EXECUTION",
          "default": "LIVE_EXECUTION",
          "title": "Requested Capability",
          "type": "string"
        },
        "risk_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Risk Policy Digest",
          "type": "string"
        },
        "sbom_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sbom Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "secrets_management_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Secrets Management Digest",
          "type": "string"
        },
        "security_assessment_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Security Assessment Digest",
          "type": "string"
        },
        "service_recovery_drill_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Service Recovery Drill Digest",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "release_id",
        "compliance_policy_pack_id",
        "compliance_policy_pack_digest",
        "legal_entity_id",
        "account_id",
        "broker_id",
        "broker_api_hostnames",
        "deployment_artifact_digest",
        "sbom_digest",
        "database_migration_digest",
        "object_store_conformance_digest",
        "backup_restore_drill_digest",
        "service_recovery_drill_digest",
        "security_assessment_digest",
        "model_validation_manifest_digest",
        "legal_compliance_digest",
        "data_rights_digest",
        "broker_agreement_digest",
        "risk_policy_digest",
        "network_policy_digest",
        "secrets_management_digest",
        "evidence_references",
        "max_recovery_drill_age_seconds",
        "created_at",
        "expires_at"
      ],
      "title": "ProductionReleaseManifest",
      "type": "object"
    },
    "ReleaseApprovalPayload": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "INDEPENDENT_REVIEWER",
            "HUMAN_OPERATOR"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "release_id",
        "manifest_digest",
        "actor_id",
        "role",
        "approved_at",
        "not_before",
        "expires_at"
      ],
      "title": "ReleaseApprovalPayload",
      "type": "object"
    },
    "ReleaseAttestationHeader": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Alg",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "typ": {
          "const": "AQ-RELEASE-ATTESTATION",
          "default": "AQ-RELEASE-ATTESTATION",
          "title": "Typ",
          "type": "string"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "ReleaseAttestationHeader",
      "type": "object"
    },
    "ReleaseEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_name": {
          "enum": [
            "COMPLIANCE_POLICY_PACK",
            "DEPLOYMENT_ARTIFACT",
            "SBOM",
            "DATABASE_MIGRATION",
            "OBJECT_STORE_CONFORMANCE",
            "BACKUP_RESTORE_DRILL",
            "SERVICE_RECOVERY_DRILL",
            "SECURITY_ASSESSMENT",
            "MODEL_VALIDATION_MANIFEST",
            "LEGAL_COMPLIANCE",
            "DATA_RIGHTS",
            "BROKER_AGREEMENT",
            "RISK_POLICY",
            "NETWORK_POLICY",
            "SECRETS_MANAGEMENT"
          ],
          "title": "Evidence Name",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/BlobRef"
        }
      },
      "required": [
        "evidence_name",
        "payload"
      ],
      "title": "ReleaseEvidenceReference",
      "type": "object"
    },
    "SignedReleaseApproval": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/ReleaseApprovalPayload"
        },
        "protected": {
          "$ref": "#/$defs/ReleaseAttestationHeader"
        },
        "signature_b64url": {
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "title": "Signature B64Url",
          "type": "string"
        }
      },
      "required": [
        "protected",
        "payload",
        "signature_b64url"
      ],
      "title": "SignedReleaseApproval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "independent_review": {
      "$ref": "#/$defs/SignedReleaseApproval"
    },
    "manifest": {
      "$ref": "#/$defs/ProductionReleaseManifest"
    },
    "operator_approval": {
      "$ref": "#/$defs/SignedReleaseApproval"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "manifest",
    "independent_review",
    "operator_approval"
  ],
  "title": "ReleaseVerificationInput",
  "type": "object"
}
