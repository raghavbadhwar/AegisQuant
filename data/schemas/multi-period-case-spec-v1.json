{
  "$defs": {
    "CorporateAction": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "cash_per_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cash Per Share"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CorporateActionKind"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "split_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split Ratio"
        }
      },
      "required": [
        "instrument_id",
        "instrument_version",
        "kind",
        "effective_at",
        "available_at"
      ],
      "title": "CorporateAction",
      "type": "object"
    },
    "CorporateActionKind": {
      "enum": [
        "CASH_DIVIDEND",
        "DELISTING_CASH",
        "SPLIT"
      ],
      "title": "CorporateActionKind",
      "type": "string"
    },
    "MarketBar": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "close_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Close Price"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "open_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Open Price"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tradable_at": {
          "format": "date-time",
          "title": "Tradable At",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Volume"
        }
      },
      "required": [
        "instrument_id",
        "instrument_version",
        "observed_at",
        "available_at",
        "tradable_at",
        "open_price",
        "close_price",
        "volume",
        "currency"
      ],
      "title": "MarketBar",
      "type": "object"
    },
    "OrderIntent": {
      "additionalProperties": false,
      "properties": {
        "client_order_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Client Order Id",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Version",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "order_type": {
          "$ref": "#/$defs/OrderType"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "side": {
          "$ref": "#/$defs/OrderSide"
        },
        "time_in_force": {
          "$ref": "#/$defs/TimeInForce"
        },
        "venue_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Venue Id",
          "type": "string"
        }
      },
      "required": [
        "client_order_id",
        "instrument_id",
        "instrument_version",
        "venue_id",
        "side",
        "order_type",
        "time_in_force",
        "quantity",
        "currency"
      ],
      "title": "OrderIntent",
      "type": "object"
    },
    "OrderSide": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "MARKET",
        "LIMIT"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "RebalancePeriod": {
      "additionalProperties": false,
      "properties": {
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "fill_at": {
          "format": "date-time",
          "title": "Fill At",
          "type": "string"
        },
        "orders": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OrderIntent"
          },
          "title": "Orders",
          "type": "array"
        },
        "period_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Period Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "period_id",
        "decision_at",
        "fill_at"
      ],
      "title": "RebalancePeriod",
      "type": "object"
    },
    "TimeInForce": {
      "enum": [
        "DAY"
      ],
      "title": "TimeInForce",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annualization_periods": {
      "default": 252,
      "minimum": 1,
      "title": "Annualization Periods",
      "type": "integer"
    },
    "bars": {
      "items": {
        "$ref": "#/$defs/MarketBar"
      },
      "title": "Bars",
      "type": "array"
    },
    "benchmark_instrument_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Benchmark Instrument Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "corporate_actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CorporateAction"
      },
      "title": "Corporate Actions",
      "type": "array"
    },
    "holdout_period_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Holdout Period Ids",
      "type": "array"
    },
    "initial_cash": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Initial Cash"
    },
    "locked_holdout_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Locked Holdout Digest",
      "type": "string"
    },
    "max_bar_age_seconds": {
      "minimum": 1,
      "title": "Max Bar Age Seconds",
      "type": "integer"
    },
    "periods": {
      "items": {
        "$ref": "#/$defs/RebalancePeriod"
      },
      "minItems": 6,
      "title": "Periods",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "strategy_trials": {
      "default": 1,
      "minimum": 1,
      "title": "Strategy Trials",
      "type": "integer"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "transaction_cost_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Transaction Cost Rate"
    },
    "walk_forward_step": {
      "minimum": 1,
      "title": "Walk Forward Step",
      "type": "integer"
    },
    "walk_forward_test_periods": {
      "minimum": 1,
      "title": "Walk Forward Test Periods",
      "type": "integer"
    },
    "walk_forward_training_periods": {
      "minimum": 1,
      "title": "Walk Forward Training Periods",
      "type": "integer"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "initial_cash",
    "transaction_cost_rate",
    "max_bar_age_seconds",
    "benchmark_instrument_id",
    "bars",
    "periods",
    "holdout_period_ids",
    "locked_holdout_digest",
    "walk_forward_training_periods",
    "walk_forward_test_periods",
    "walk_forward_step"
  ],
  "title": "MultiPeriodCaseSpec",
  "type": "object"
}
