{
  "additionalProperties": false,
  "properties": {
    "calculation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calculation Id"
    },
    "claim_id": {
      "format": "uuid",
      "title": "Claim Id",
      "type": "string"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_coordinate": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Coordinate",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "unit": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "tenant_id",
    "claim_id",
    "name",
    "value",
    "unit",
    "evidence_id",
    "source_coordinate"
  ],
  "title": "NumericClaim",
  "type": "object"
}
