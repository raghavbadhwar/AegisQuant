{
  "$defs": {
    "DecisionOutcome": {
      "enum": [
        "APPROVE",
        "REJECT",
        "HALT",
        "COUNTERPROPOSAL"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "RuleResult": {
      "additionalProperties": false,
      "properties": {
        "input_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Input Ids",
          "type": "array"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "reason_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RuleStatus"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "status",
        "reason_code"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "RuleStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "WARN",
        "NOT_APPLICABLE"
      ],
      "title": "RuleStatus",
      "type": "string"
    },
    "TradingEnvironment": {
      "enum": [
        "SIM",
        "PAPER"
      ],
      "title": "TradingEnvironment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Account Id",
      "type": "string"
    },
    "approved_order_bundle_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved Order Bundle Digest"
    },
    "audience": {
      "const": "aegisquant-execution",
      "default": "aegisquant-execution",
      "title": "Audience",
      "type": "string"
    },
    "broker_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Broker Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/TradingEnvironment"
    },
    "execution_plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Plan Digest",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "fx_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fx Snapshot Digest",
      "type": "string"
    },
    "input_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Manifest Digest",
      "type": "string"
    },
    "issuance_sequence": {
      "minimum": 1,
      "title": "Issuance Sequence",
      "type": "integer"
    },
    "issuer": {
      "const": "aegisquant-hard-risk",
      "default": "aegisquant-hard-risk",
      "title": "Issuer",
      "type": "string"
    },
    "kill_switch_epoch": {
      "minimum": 0,
      "title": "Kill Switch Epoch",
      "type": "integer"
    },
    "legal_entity_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Legal Entity Id",
      "type": "string"
    },
    "market_data_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Market Data Snapshot Digest",
      "type": "string"
    },
    "model_validation_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Validation Manifest Digest",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{32,128}$",
      "title": "Nonce",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "open_orders_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Open Orders Snapshot Digest",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/DecisionOutcome"
    },
    "policy_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Bundle Digest",
      "type": "string"
    },
    "policy_epoch": {
      "minimum": 1,
      "title": "Policy Epoch",
      "type": "integer"
    },
    "portfolio_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Portfolio Snapshot Digest",
      "type": "string"
    },
    "portfolio_state_sequence": {
      "minimum": 0,
      "title": "Portfolio State Sequence",
      "type": "integer"
    },
    "projected_portfolio_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projected Portfolio Digest"
    },
    "reference_data_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Reference Data Snapshot Digest",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requested_order_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Requested Order Bundle Digest",
      "type": "string"
    },
    "required_human_approval_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Human Approval Digest"
    },
    "rule_results": {
      "items": {
        "$ref": "#/$defs/RuleResult"
      },
      "title": "Rule Results",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "strategy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Strategy Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "decision_id",
    "request_id",
    "case_id",
    "issuance_sequence",
    "nonce",
    "environment",
    "legal_entity_id",
    "account_id",
    "broker_id",
    "strategy_id",
    "outcome",
    "policy_bundle_digest",
    "policy_epoch",
    "kill_switch_epoch",
    "input_manifest_digest",
    "portfolio_state_sequence",
    "portfolio_snapshot_digest",
    "open_orders_snapshot_digest",
    "market_data_snapshot_digest",
    "reference_data_snapshot_digest",
    "fx_snapshot_digest",
    "model_validation_manifest_digest",
    "execution_plan_digest",
    "requested_order_bundle_digest",
    "rule_results",
    "created_at",
    "not_before",
    "expires_at"
  ],
  "title": "RiskDecisionPayload",
  "type": "object"
}
