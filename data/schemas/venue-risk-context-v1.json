{
  "$defs": {
    "TradingEnvironment": {
      "enum": [
        "SIM",
        "PAPER"
      ],
      "title": "TradingEnvironment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Account Id",
      "type": "string"
    },
    "broker_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Broker Id",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/TradingEnvironment"
    },
    "fx_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fx Snapshot Digest",
      "type": "string"
    },
    "input_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Manifest Digest",
      "type": "string"
    },
    "kill_switch_epoch": {
      "minimum": 0,
      "title": "Kill Switch Epoch",
      "type": "integer"
    },
    "legal_entity_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Legal Entity Id",
      "type": "string"
    },
    "market_data_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Market Data Snapshot Digest",
      "type": "string"
    },
    "model_validation_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Validation Manifest Digest",
      "type": "string"
    },
    "open_orders_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Open Orders Snapshot Digest",
      "type": "string"
    },
    "policy_epoch": {
      "minimum": 1,
      "title": "Policy Epoch",
      "type": "integer"
    },
    "portfolio_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Portfolio Snapshot Digest",
      "type": "string"
    },
    "portfolio_state_sequence": {
      "minimum": 0,
      "title": "Portfolio State Sequence",
      "type": "integer"
    },
    "reference_data_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Reference Data Snapshot Digest",
      "type": "string"
    },
    "strategy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Strategy Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "environment",
    "legal_entity_id",
    "account_id",
    "broker_id",
    "strategy_id",
    "policy_epoch",
    "kill_switch_epoch",
    "portfolio_state_sequence",
    "input_manifest_digest",
    "portfolio_snapshot_digest",
    "open_orders_snapshot_digest",
    "market_data_snapshot_digest",
    "reference_data_snapshot_digest",
    "fx_snapshot_digest",
    "model_validation_manifest_digest"
  ],
  "title": "VenueRiskContext",
  "type": "object"
}
