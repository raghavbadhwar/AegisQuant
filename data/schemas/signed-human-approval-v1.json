{
  "$defs": {
    "HumanApprovalPayload": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "approved_order_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Approved Order Bundle Digest",
          "type": "string"
        },
        "approver_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Approver Id",
          "type": "string"
        },
        "approver_role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Approver Role",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/TradingEnvironment"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issuer": {
          "const": "aegisquant-approval",
          "default": "aegisquant-approval",
          "title": "Issuer",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{32,128}$",
          "title": "Nonce",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "policy_epoch": {
          "minimum": 1,
          "title": "Policy Epoch",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "environment",
        "approval_id",
        "approver_id",
        "approver_role",
        "account_id",
        "approved_order_bundle_digest",
        "policy_epoch",
        "nonce",
        "created_at",
        "not_before",
        "expires_at"
      ],
      "title": "HumanApprovalPayload",
      "type": "object"
    },
    "HumanApprovalProtectedHeader": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Alg",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "typ": {
          "const": "AQ-HUMAN-APPROVAL",
          "default": "AQ-HUMAN-APPROVAL",
          "title": "Typ",
          "type": "string"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "HumanApprovalProtectedHeader",
      "type": "object"
    },
    "TradingEnvironment": {
      "enum": [
        "SIM",
        "PAPER"
      ],
      "title": "TradingEnvironment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/HumanApprovalPayload"
    },
    "protected": {
      "$ref": "#/$defs/HumanApprovalProtectedHeader"
    },
    "signature_b64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature B64Url",
      "type": "string"
    }
  },
  "required": [
    "protected",
    "payload",
    "signature_b64url"
  ],
  "title": "SignedHumanApproval",
  "type": "object"
}
