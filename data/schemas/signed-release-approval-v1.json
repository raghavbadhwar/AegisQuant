{
  "$defs": {
    "ReleaseApprovalPayload": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "INDEPENDENT_REVIEWER",
            "HUMAN_OPERATOR"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "release_id",
        "manifest_digest",
        "actor_id",
        "role",
        "approved_at",
        "not_before",
        "expires_at"
      ],
      "title": "ReleaseApprovalPayload",
      "type": "object"
    },
    "ReleaseAttestationHeader": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Alg",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "typ": {
          "const": "AQ-RELEASE-ATTESTATION",
          "default": "AQ-RELEASE-ATTESTATION",
          "title": "Typ",
          "type": "string"
        }
      },
      "required": [
        "key_id"
      ],
      "title": "ReleaseAttestationHeader",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/ReleaseApprovalPayload"
    },
    "protected": {
      "$ref": "#/$defs/ReleaseAttestationHeader"
    },
    "signature_b64url": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "title": "Signature B64Url",
      "type": "string"
    }
  },
  "required": [
    "protected",
    "payload",
    "signature_b64url"
  ],
  "title": "SignedReleaseApproval",
  "type": "object"
}
