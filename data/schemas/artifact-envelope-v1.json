{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "retention_class": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Retention Class",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "uri",
        "content_digest",
        "size_bytes",
        "media_type",
        "retention_class"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "public",
        "licensed",
        "confidential",
        "restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_digest"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ProducerStamp": {
      "additionalProperties": false,
      "properties": {
        "actual_model": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Model"
        },
        "actual_provider": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Provider"
        },
        "agent_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Agent Version",
          "type": "string"
        },
        "prompt_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Bundle Digest",
          "type": "string"
        },
        "route_decision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Decision Id"
        },
        "skill_bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Skill Bundle Digest",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "agent_version",
        "prompt_bundle_digest",
        "skill_bundle_digest"
      ],
      "title": "ProducerStamp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_schema_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Schema Version",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Data Snapshot Id",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "parent_artifact_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Parent Artifact Ids",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/BlobRef"
    },
    "payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ProducerStamp"
    },
    "schema_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "artifact_id",
    "case_id",
    "schema_id",
    "artifact_schema_version",
    "payload",
    "payload_digest",
    "producer",
    "data_snapshot_id",
    "classification",
    "created_at",
    "idempotency_key"
  ],
  "title": "ArtifactEnvelope",
  "type": "object"
}
